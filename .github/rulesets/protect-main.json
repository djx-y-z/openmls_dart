{
  "name": "Protect main branch",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "FRB bindings were regenerated",
            "integration_id": 15368
          },
          {
            "context": "test / Test (Linux x86_64)",
            "integration_id": 15368
          },
          {
            "context": "test / Test (Linux ARM64)",
            "integration_id": 15368
          },
          {
            "context": "test / Test (macOS ARM64)",
            "integration_id": 15368
          },
          {
            "context": "test / Test (Windows x86_64)",
            "integration_id": 15368
          },
          {
            "context": "test / Security Audit (Rust)",
            "integration_id": 15368
          },
          {
            "context": "test / Dependency Policy (cargo-deny)",
            "integration_id": 15368
          },
          {
            "context": "test / MSRV (rust-version from Cargo.toml)",
            "integration_id": 15368
          },
          {
            "context": "test / Workflow Lint (actionlint)",
            "integration_id": 15368
          },
          {
            "context": "test / Cross-compile (Android arm64-v8a)",
            "integration_id": 15368
          },
          {
            "context": "test / Cross-compile (Android armeabi-v7a)",
            "integration_id": 15368
          },
          {
            "context": "test / Cross-compile (Android x86_64)",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge", "squash", "rebase"]
      }
    }
  ]
}
