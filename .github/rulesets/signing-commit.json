{
  "name": "Signing commit",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": ["refs/heads/dependabot/**/*"]
    }
  },
  "rules": [
    { "type": "non_fast_forward" },
    { "type": "required_signatures" }
  ]
}
